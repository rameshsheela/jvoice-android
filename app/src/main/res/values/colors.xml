<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Brand palette, taken from the J Voice logo. Mirrors theme/Color.kt. -->
    <color name="jv_red">#DD0B1E</color>
    <color name="jv_red_dark">#9E0715</color>
    <color name="jv_blue">#17318F</color>
    <color name="jv_blue_dark">#0D1F63</color>
    <color name="jv_white">#FFFFFFFF</color>

    <!--
      The launcher plate. The logo sits on black, but an adaptive icon's
      background is what shows through the mask on every home screen, and flat
      black reads as a hole on a dark wallpaper - so the plate is the logo's
      deep royal blue instead, which is also what the globe is drawn in.
    -->
    <color name="jv_launcher_background">#0D1F63</color>

    <!-- Kept: the old name is still referenced by themes.xml. -->
    <color name="jv_primary">#DD0B1E</color>
    <!-- Splash ground: the brand navy. Must match SplashNavy in SplashScreen.kt. -->
    <color name="jv_splash_background">#0D1F63</color>
</resources>
